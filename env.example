# ─────────────────────────────────────────────
# PACTFORM — Environment Variables
# Rename this file to .env and fill in the values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Neon Postgres connection string
# Get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ── EIP-712 Voucher Signer ────────────────────
# Private key of the wallet that signs payment vouchers (backend only)
# This address must match VITE_PACTFORM_SIGNER_ADDRESS
PACTFORM_SIGNER_KEY=0xyour_private_key_here

# ── Frontend (VITE_ prefix = exposed to browser) ─
# Public address of the signer wallet above
VITE_PACTFORM_SIGNER_ADDRESS=0xYourSignerPublicAddress

# Deployed PactFormCollectSplit contract (Arc Mainnet)
VITE_COLLECT_SPLIT_ADDRESS=0x30fc8C0E9DCe79272F960F991d0A271D859C837C

# Deployed PactFormEscrow contract (Arc Mainnet)
VITE_ESCROW_ADDRESS=0x19F95Bb32CeD110B0221AD80336Be5f90cb0d0E0

# ── AI Form Generation (optional) ─────────────
# OpenRouter API key — enables the AI "Generate with AI" feature
# Get one at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# ── Arc Studio RPC Proxy (set automatically inside Arc Studio) ──
# These are provisioned by Arc Studio and do not need to be set manually
# when running inside Arc Studio. Set them if running outside Arc Studio
# and you want to use the Arc RPC proxy instead of a public endpoint.
VITE_RPC_PROXY_BASE_URL=
VITE_RPC_PROXY_TOKEN=
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=

# ── Forge Deploy Scripts (local only, not used in production) ─────
# Deployer wallet private key for forge scripts
PRIVATE_KEY=0xyour_deployer_private_key
# Deployer/signer address alias used in forge scripts
PACTFORM_SIGNER_ADDR=0xYourSignerPublicAddress
